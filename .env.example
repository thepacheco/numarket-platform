# Names only. Values live in Vercel project settings (and later the cloud
# secrets manager). Never commit real values. Per-tenant secrets are never
# environment variables.

# ---- Stage A (Portal + demo) ----
DATABASE_URL=                  # Postgres (Neon). Pooled connection string.
DEMO_HOSTS=                    # app.numarket.us  (hosts that open the demo workspace)
OPS_HOSTS=                     # ops.numarket.us  (hosts that open the ops console)
APP_DOMAIN=                    # numarket.app once bought ({tenant}.numarket.app)
CRON_SECRET=                   # random string; Vercel Cron sends it to /api/cron/demo-reset and /api/cron/alerts
RESEND_API_KEY=                # optional: turns on alert emails (Resend). Without it alerts stay in the Portal.
EMAIL_FROM=                    # with the key: "numarket <alerts@numarket.us>", domain verified in Resend
ALLOW_DEV_SIGNIN=              # 1 for local development only. Never set in production.

# ---- Sign-in provider (WorkOS AuthKit by default) ----
AUTH_API_KEY=
AUTH_CLIENT_ID=
AUTH_WEBHOOK_SECRET=
AUTH_COOKIE_PASSWORD=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Stage B (worker, Snowflake, connectors) ----
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
WORKER_INTERNAL_URL=
WORKER_SHARED_SECRET=
SECRETS_PROVIDER=              # aws
SECRETS_REGION=
KMS_KEY_ID=
SNOWFLAKE_ORG_NAME=
SNOWFLAKE_ORGADMIN_ACCOUNT=
SNOWFLAKE_ORGADMIN_USER=
SNOWFLAKE_ORGADMIN_PRIVATE_KEY_REF=   # reference to a secret, not the key
SNOWFLAKE_DEFAULT_REGION=
WORKER_STATIC_IP=
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_ENVIRONMENT=            # sandbox | production
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# email: RESEND_API_KEY and EMAIL_FROM, under Stage A above
SENTRY_DSN=
